---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { institutionTypeLabels } from '@/lib/institution'

interface Props {
  href: string
  name: string
  short?: string
  description?: string
  type: 'public' | 'private'
  logo?: any
}

const { href, name, short, description, type, logo } = Astro.props
---

<a
  href={href}
  class="not-prose group flex items-start gap-4 rounded-lg border border-border bg-muted/30 p-4 transition-colors hover:bg-accent/50"
>
  {
    logo ? (
      <div class="flex size-12 shrink-0 items-center justify-center rounded-md overflow-hidden">
        <Image src={logo} alt={name} class="h-full w-full object-cover" />
      </div>
    ) : (
      <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary/10">
        <Icon name="mdi:domain" class="size-6 text-primary" />
      </div>
    )
  }

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h4 class="text-sm font-semibold text-foreground">
        {short ?? name}
      </h4>
      <span
        class="badge text-xs shrink-0"
        data-variant={type === 'public' ? 'success' : 'secondary'}
      >
        {institutionTypeLabels[type]}
      </span>
    </div>

    {
      short && name !== short ? (
        <p class="text-xs text-muted-foreground truncate">{name}</p>
      ) : null
    }

    {
      description ? (
        <p class="mt-1.5 text-xs text-muted-foreground line-clamp-2">
          {description}
        </p>
      ) : null
    }
  </div>
</a>