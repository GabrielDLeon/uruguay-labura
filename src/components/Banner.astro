---
import { Icon } from "astro-icon/components";
---

<aside
  class="bg-gradient-to-r from-amber-600 to-orange-600 dark:from-amber-700 dark:to-orange-700 text-white text-xs leading-5 py-[0.375rem] px-4"
  data-pagefind-ignore
>
  <div class="flex items-center justify-center gap-2 mx-auto max-w-7xl">
    <Icon
      name="mdi:alert-outline"
      size={16}
      class="shrink-0"
      aria-hidden="true"
    />
    <span>
      El proyecto se encuentra en desarrollo. {""}
      <span class="hidden sm:inline">
        Puede contener errores o información desactualizada.
      </span>
    </span>
    <a
      href="https://github.com/GabrielDLeon/uruguay-labura"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 whitespace-nowrap font-medium underline underline-offset-2 transition-opacity duration-150 hover:opacity-85"
    >
      Ver en GitHub
      <Icon name="mdi:open-in-new" size={14} aria-hidden="true" />
    </a>
  </div>
</aside>
