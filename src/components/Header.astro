---
import { Icon } from "astro-icon/components";
import NavDropdown from "./common/NavDropdown.astro";
import SearchModal from "@/components/search/SearchModal.astro";

const sections = [
  {
    id: "empleos",
    label: "Empleos",
    icon: "keyline-icons:briefcase-fill",
    links: [
      {
        href: "/empleos",
        label: "Todos los llamados",
        icon: "keyline-icons:briefcase-fill",
      },
      {
        href: "/empleos/datos",
        label: "Datos",
        icon: "keyline-icons:chart-bar-fill",
      },
      {
        href: "/empleos/guardados",
        label: "Guardados",
        icon: "keyline-icons:bookmark-fill",
      },
    ],
  },
  {
    id: "educacion",
    label: "Educación",
    icon: "keyline-icons:graduation-cap-fill",
    links: [
      {
        href: "/educacion/carreras",
        label: "Carreras",
        icon: "keyline-icons:graduation-cap-fill",
      },
      {
        href: "/educacion/instituciones",
        label: "Instituciones",
        icon: "keyline-icons:landmark-fill",
      },
      {
        href: "/educacion/becas",
        label: "Becas",
        icon: "keyline-icons:hand-coins-fill",
      },
    ],
  },
];

const repoUrl = "https://github.com/GabrielDLeon/uruguay-labura";
---

<header
  data-pagefind-ignore
  class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--card-bg)]"
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="flex items-center gap-2 py-2 sm:gap-4 sm:py-3">
      <a href="/" class="text-base font-semibold text-foreground sm:text-lg">
        🇺🇾 Labura
      </a>

      <nav class="hidden items-center gap-1 text-sm lg:flex">
        {
          sections.map((section) => (
            <NavDropdown
              id={section.id}
              label={section.label}
              icon={section.icon}
              minWidth="12rem"
            >
              {section.links.map((link) => (
                <a href={link.href} role="menuitem">
                  <Icon name={link.icon} size={16} aria-hidden="true" />
                  {link.label}
                </a>
              ))}
            </NavDropdown>
          ))
        }
      </nav>

      <SearchModal wrapperClass="ml-auto min-w-0 lg:ml-0 lg:flex-1" />

      <div class="flex items-center gap-2">
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub repository"
          class="btn hidden lg:inline-flex"
          data-variant="outline"
          data-size="icon"
        >
          <Icon name="mdi:github" size={24} aria-hidden="true" />
        </a>

        <button
          type="button"
          aria-label="Toggle dark mode"
          data-tooltip="Toggle dark mode"
          data-side="bottom"
          onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
          class="btn hidden lg:inline-flex"
          data-variant="outline"
          data-size="icon"
        >
          <span class="hidden dark:block">
            <Icon name="keyline-icons:sun-fill" size={24} aria-hidden="true" />
          </span>
          <span class="block dark:hidden">
            <Icon name="keyline-icons:moon-fill" size={24} aria-hidden="true" />
          </span>
        </button>

        <button
          type="button"
          data-menu-open
          aria-label="Abrir menú"
          aria-haspopup="dialog"
          aria-controls="mobile-menu"
          class="btn lg:hidden"
          data-variant="outline"
          data-size="icon"
        >
          <Icon name="keyline-icons:menu-fill" size={24} aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</header>

<dialog
  id="mobile-menu"
  class="drawer lg:hidden"
  data-side="right"
  aria-label="Menú"
>
  <div class="bg-background text-foreground">
    <header
      class="flex flex-row items-center gap-2 border-b border-border px-4 py-3"
    >
      <span class="text-base font-semibold">Menú</span>
      <button
        type="button"
        data-menu-close
        aria-label="Cerrar menú"
        class="btn ml-auto"
        data-variant="ghost"
        data-size="icon-sm"
      >
        <Icon name="keyline-icons:x-fill" size={24} aria-hidden="true" />
      </button>
    </header>

    <section class="flex flex-col gap-4 p-4">
      {
        sections.map((section) => (
          <div>
            <p class="mb-1 px-3 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
              {section.label}
            </p>
            <ul>
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-foreground transition-colors hover:bg-muted"
                  >
                    <Icon
                      name={link.icon}
                      size={16}
                      class="shrink-0"
                      aria-hidden="true"
                    />
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <footer class="flex flex-col gap-2 border-t border-border p-4">
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn justify-start"
        data-variant="outline"
        data-size="sm"
      >
        <Icon name="mdi:github" size={16} aria-hidden="true" />
        GitHub
      </a>

      <button
        type="button"
        onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))"
        class="btn justify-start"
        data-variant="outline"
        data-size="sm"
      >
        <span class="hidden dark:block">
          <Icon name="keyline-icons:sun-fill" size={16} aria-hidden="true" />
        </span>
        <span class="block dark:hidden">
          <Icon name="keyline-icons:moon-fill" size={16} aria-hidden="true" />
        </span>
        Cambiar tema
      </button>
    </footer>
  </div>
</dialog>

<script>
  const drawer = document.getElementById(
    "mobile-menu",
  ) as HTMLDialogElement | null;

  if (drawer) {
    document.querySelectorAll("[data-menu-open]").forEach((element) => {
      element.addEventListener("click", () => drawer.showModal());
    });

    document.querySelectorAll("[data-menu-close]").forEach((element) => {
      element.addEventListener("click", () => drawer.close());
    });

    drawer.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a")) drawer.close();
    });

    window
      .matchMedia("(min-width: 1024px)")
      .addEventListener("change", (event) => {
        if (event.matches) drawer.close();
      });
  }
</script>
