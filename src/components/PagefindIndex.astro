---
interface Props {
  title: string
  description?: string | null
  kind: "carrera" | "institucion" | "beca"
  meta?: Record<string, string | undefined | null>
}

const { title, description, kind, meta } = Astro.props
---

<div data-pagefind-body class="sr-only">
  <h1>{title}</h1>
  {description ? <p>{description}</p> : null}
  <span data-pagefind-meta={`kind:${kind}`}></span>
  {
    Object.entries(meta ?? {}).map(([key, value]) =>
      value ? <span data-pagefind-meta={`${key}:${value}`}></span> : null,
    )
  }
</div>
