---
import type { TopOrganization } from "@/types/jobs"

export interface Props {
  organizations: TopOrganization[]
}

const { organizations } = Astro.props
const maxCount = organizations.length > 0 ? organizations[0].count : 1
---

<section>
  <h3 class="text-lg font-bold text-foreground mb-4">Top 10 organismos con más llamados</h3>

  <div class="space-y-2">
    {
      organizations.map((org, i) => (
        <div class="flex items-center gap-3">
          <span
            class="flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--muted)] text-xs font-semibold text-muted-foreground"
          >
            {i + 1}
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-sm font-medium text-foreground truncate">{org.name}</p>
              <span class="shrink-0 text-sm font-semibold text-foreground">{org.count}</span>
            </div>
            <div class="mt-1 h-2 w-full rounded-full bg-[var(--muted)]">
              <div
                class="h-full rounded-full transition-all"
                style={{
                  width: `${(org.count / maxCount) * 100}%`,
                  backgroundColor: i < 3
                    ? 'var(--bar-l1)'
                    : i < 6
                      ? 'var(--bar-l2)'
                      : 'var(--bar-l3)',
                }}
              ></div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
