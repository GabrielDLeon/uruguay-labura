---
import { Icon } from "astro-icon/components";
import { formatDateShortMonth } from "@/lib/dates";

interface Props {
  createdAt?: string;
  updatedAt?: string;
}

const { updatedAt } = Astro.props;

const hasUpdated = updatedAt !== undefined && updatedAt !== "";
---

{
  hasUpdated ? (
    <footer class="border-t border-border pt-4 text-sm text-muted-foreground">
      <p class="flex items-center gap-1.5">
        <Icon name="mdi:update" class="size-4 shrink-0" />
        Actualizado{" "}
        <time datetime={updatedAt}>{formatDateShortMonth(updatedAt)}</time>
      </p>
    </footer>
  ) : null
}
