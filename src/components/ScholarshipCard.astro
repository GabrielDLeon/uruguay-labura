---
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  short?: string
  url: string
  description?: string
  /** Free-text type (e.g. "Beca privada por mérito académico"), fallback for the description */
  type: string
  tags: string[]
}

const { title, short, url, description, type, tags } = Astro.props

const typeIcons: Record<string, string> = {
  estatal: 'mdi:bank',
  privada: 'mdi:domain',
  internacional: 'mdi:earth',
  gremial: 'mdi:account-group',
}

const typeLabels: Record<string, string> = {
  estatal: 'Estatal',
  privada: 'Privada',
  internacional: 'Internacional',
  gremial: 'Gremial',
}

const primaryTag = tags.find((t) => typeIcons[t])
const icon = primaryTag ? typeIcons[primaryTag] : 'mdi:school'
const category = primaryTag ? typeLabels[primaryTag] : undefined
---

<a
  href={url}
  class="not-prose group flex items-start gap-4 rounded-lg border border-border bg-muted/30 p-4 transition-colors hover:bg-accent/50"
>
  <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary/10">
    <Icon name={icon} class="size-6 text-primary" />
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h4 class="text-sm font-semibold text-foreground">
        {short ?? title}
      </h4>
      {
        category ? (
          <span class="badge text-xs shrink-0" data-variant="outline">
            {category}
          </span>
        ) : null
      }
    </div>

    {
      description || type ? (
        <p class="mt-1.5 text-xs text-muted-foreground line-clamp-2">
          {description ?? type}
        </p>
      ) : null
    }
  </div>
</a>
