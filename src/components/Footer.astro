---
import { navSections, projectLinks } from "@/lib/nav";

const columns = [
  ...navSections.map((section) => ({
    title: section.label,
    links: section.links,
  })),
  { title: "Proyecto", links: projectLinks },
];

const isExternal = (href: string) => href.startsWith("http");
---

<footer
  data-pagefind-ignore
  class="border-t border-[var(--color-border)] bg-[var(--card-bg)]/50"
>
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
      <!-- Uruguay Labura -->
      <div class="max-w-xs">
        <h3 class="mb-3 text-sm font-semibold text-foreground">
          Uruguay Labura
        </h3>
        <p class="text-sm text-muted-foreground">
          Directorio de llamados laborales y educación en Uruguay con filtros
          simples y acceso rápido a cada oportunidad.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:gap-x-12">
        {columns.map((column) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold text-foreground">
              {column.title}
            </h3>
            <nav class="grid gap-2 text-sm">
              {column.links.map((link) => (
                <a
                  href={link.href}
                  target={isExternal(link.href) ? "_blank" : undefined}
                  rel={
                    isExternal(link.href) ? "noopener noreferrer" : undefined
                  }
                  class="text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Aviso legal -->
  <div class="border-t border-[var(--color-border)]">
    <div class="mx-auto w-full max-w-7xl px-4 py-4 text-xs text-muted-foreground sm:px-6">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <p>
          © {new Date().getFullYear()} Uruguay Labura. Proyecto en evolución.
        </p>
        <p>
          Creado por{" "}
          <a
            href="https://github.com/gabrieldleon"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-foreground"
          >
            Gabriel de León
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
