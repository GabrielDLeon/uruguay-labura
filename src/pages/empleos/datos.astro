---
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import DashboardSection from "@/components/dashboard/DashboardSection.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import { absUrl, breadcrumbList } from "@/lib/seo";
import { getBreadcrumbs } from "@/lib/breadcrumbs";
import { computeDashboard } from "@/lib/jobs-domain";
import type { JobsDataset } from "@/types/jobs";
import jobsData from "@/data/jobs.generated.json";

const dataset = jobsData as unknown as JobsDataset;
const dashboard = computeDashboard(dataset.jobs, dataset.scrapedAt);

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(breadcrumbs, `${absUrl("/empleos/datos")}#breadcrumb`),
  ],
};
---

<Layout
  title="Datos de llamados laborales"
  description="Estadísticas de llamados laborales en Uruguay: evolución, organismos, tipos de tarea y cuotas."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <PagefindIndex
    title="Datos de llamados laborales en Uruguay"
    description="Estadísticas de llamados laborales en Uruguay: evolución, organismos, tipos de tarea y cuotas."
    kind="pagina"
  />

  <Block>
    <PageHeader
      title="Datos de llamados"
      description="Estadísticas agregadas de los llamados de sitios oficiales de Uruguay: evolución en el tiempo, organismos con más llamados, distribución por tipo de tarea y cuotas."
    />

    {
      dataset.jobs.length > 0 ? (
        <DashboardSection dashboard={dashboard} />
      ) : (
        <p class="text-sm text-muted-foreground">
          No hay datos disponibles por el momento.
        </p>
      )
    }
  </Block>
</Layout>
