---
import SavedJobsBoard from "@/components/jobs/SavedJobsBoard";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import { absUrl, breadcrumbList } from "@/lib/seo";
import { getBreadcrumbs } from "@/lib/breadcrumbs";

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(
      breadcrumbs,
      `${absUrl("/empleos/guardados")}#breadcrumb`,
    ),
  ],
};
---

<Layout
  title="Empleos guardados"
  description="Tus llamados laborales guardados en Uruguay."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Block>
    <PageHeader title="Empleos guardados">
      Llamados que guardaste para postularte más tarde. Se guardan
      automáticamente en tu navegador.
    </PageHeader>

    <div data-pagefind-ignore="all">
      <SavedJobsBoard client:load />
    </div>
  </Block>
</Layout>
