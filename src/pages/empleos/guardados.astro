---
import SavedJobsBoard from "@/components/jobs/SavedJobsBoard";
import SavedSearchesBoard from "@/components/jobs/SavedSearchesBoard";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Icon } from "astro-icon/components";
import jobsDataset from "@/data/jobs.generated.json";
import { formatDateShort } from "@/lib/dates";
import { absUrl, breadcrumbList } from "@/lib/seo";
import { getBreadcrumbs } from "@/lib/breadcrumbs";

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const updatedAt = formatDateShort(jobsDataset.scrapedAt);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(breadcrumbs, `${absUrl("/empleos/guardados")}#breadcrumb`),
  ],
};
---

<Layout
  title="Guardados"
  description="Tus llamados favoritos y búsquedas guardadas en Uruguay."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Block>
    <PageHeader title="Guardados">
      Tus llamados favoritos y las búsquedas que seguís. Se guardan en tu
      navegador.
    </PageHeader>

    <p
      class="text-muted-foreground mb-10 inline-flex items-center gap-1 text-xs"
    >
      <Icon name="mdi:clock-outline" size={14} aria-hidden="true" />
      Actualizado: {updatedAt}
    </p>

    <section class="grid gap-4">
      <h2 class="flex items-center gap-2 text-xl font-semibold text-foreground">
        <Icon name="mdi:bookmark-outline" size={20} aria-hidden="true" />
        Empleos guardados
      </h2>
      <div data-pagefind-ignore="all">
        <SavedJobsBoard client:load />
      </div>
    </section>

    <section class="mt-12 grid gap-4">
      <h2 class="flex items-center gap-2 text-xl font-semibold text-foreground">
        <Icon name="mdi:star-outline" size={20} aria-hidden="true" />
        Búsquedas guardadas
      </h2>
      <div data-pagefind-ignore="all">
        <SavedSearchesBoard client:load />
      </div>
    </section>
  </Block>
</Layout>
