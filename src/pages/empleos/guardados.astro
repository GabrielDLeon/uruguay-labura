---
import SavedItemsTabs from "@/components/jobs/SavedItemsTabs";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import { absUrl, breadcrumbList } from "@/lib/seo";
import { getBreadcrumbs } from "@/lib/breadcrumbs";

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(breadcrumbs, `${absUrl("/empleos/guardados")}#breadcrumb`),
  ],
};
---

<Layout
  title="Guardados"
  description="Tus llamados favoritos y búsquedas guardadas en Uruguay, con novedades."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Block>
    <PageHeader title="Guardados">
      Tus llamados favoritos y las búsquedas que seguís. Guardá lo que te
      interesa y volvé para ver qué llamados nuevos aparecieron. Todo se
      guarda en tu navegador.
    </PageHeader>

    <div data-pagefind-ignore="all">
      <SavedItemsTabs client:load />
    </div>
  </Block>
</Layout>
