---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Icon } from "astro-icon/components";

const entries = await getCollection(
  "becas",
  ({ data }) => import.meta.env.DEV || !data.draft,
);

entries.sort((a, b) => a.data.title.localeCompare(b.data.title, "es"));

const typeIcons: Record<string, string> = {
  estatal: "mdi:bank",
  privada: "mdi:domain",
  internacional: "mdi:earth",
  gremial: "mdi:account-group",
};
---

<Layout
  title="Becas en Uruguay"
  description="Guía de becas disponibles en Uruguay para estudiantes nacionales y extranjeros. Becas estatales, privadas e internacionales."
>
  <PageHeader
    title="Becas en Uruguay"
    description="Recopilación de las principales becas disponibles en Uruguay para estudiantes de grado, posgrado y educación media. Encontrá oportunidades de financiamiento estatal, privado e internacional."
    class="pt-8"
  />

  <section class="pb-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry) => {
          const primaryTag = entry.data.tags.find(
            (t) => typeIcons[t],
          )
          const icon = primaryTag
            ? typeIcons[primaryTag]
            : "mdi:school"

          return (
            <a
              href={`/becas/${entry.id}`}
              class="block rounded-xl border bg-card p-5 hover:shadow-md transition-shadow"
            >
              <div class="flex items-start gap-4">
                <div class="shrink-0 flex size-10 items-center justify-center rounded-lg bg-muted">
                  <Icon name={icon} class="size-5 text-muted-foreground" />
                </div>
                <div class="min-w-0">
                  <h3 class="font-semibold text-foreground leading-snug">
                    {entry.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                    {entry.data.description ?? entry.data.type}
                  </p>
                  {
                    entry.data.tags.length > 0 ? (
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {entry.data.tags.slice(0, 3).map((tag) => (
                          <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                            {tag}
                          </span>
                        ))}
                      </div>
                    ) : null
                  }
                </div>
              </div>
            </a>
          )
        })
      }
    </div>
  </section>
</Layout>
