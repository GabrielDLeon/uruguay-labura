---
import { getCollection, render } from "astro:content";

import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import AsideSection from "@/components/AsideSection.astro";
import KeyValueList from "@/components/KeyValueList.astro";

export async function getStaticPaths() {
  const entries = await getCollection(
    "becas",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabelMap: Record<string, string> = {
  estatal: "Estatal",
  privada: "Privada",
  internacional: "Internacional",
  gremial: "Gremial",
};

const detailItems = [
  {
    label: "Tipo",
    value: entry.data.type,
  },
  {
    label: "Institución",
    value: entry.data.institution,
  },
];
---

<Layout
  title={entry.data.title}
  description={entry.data.description ?? `Información sobre ${entry.data.title} en Uruguay.`}
>
  <div class="border-b -mx-4 sm:-mx-6 px-4 sm:px-6 pt-8 pb-6">
    <div class="mb-4">
      <a
        href="/becas"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Volver a Becas
      </a>
    </div>

    <div>
      <h1 class="text-2xl mb-1 font-bold text-foreground sm:text-3xl">
        {entry.data.title}
      </h1>
      <p class="text-muted-foreground text-base">
        {entry.data.institution}
      </p>
    </div>
  </div>

  <div data-pagefind-body>
    <div class="grid md:grid-cols-3">
      <aside class="flex flex-col gap-8 h-full md:order-2 md:border-l md:pl-8 pt-8 pb-8 mb-8 md:mb-0">
        {
          entry.data.description ? (
            <AsideSection title="Descripción">
              <p class="text-sm text-foreground leading-relaxed">
                {entry.data.description}
              </p>
            </AsideSection>
          ) : null
        }

        <AsideSection title="Detalles">
          <KeyValueList items={detailItems} />
        </AsideSection>

        {
          entry.data.tags.length > 0 ? (
            <AsideSection title="Categorías">
              <div class="flex flex-wrap gap-2">
                {
                  entry.data.tags.map((tag) => (
                    <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                      {typeLabelMap[tag] ?? tag}
                    </span>
                  ))
                }
              </div>
            </AsideSection>
          ) : null
        }

        <AsideSection title="Enlaces">
          <div class="flex flex-col gap-2">
            <a
              href={entry.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              data-size="sm"
            >
              Sitio web oficial
            </a>
          </div>
        </AsideSection>

        <div class="flex justify-center">
          <a
            href={`https://github.com/GabrielDLeon/uruguay-laburos/edit/main/src/content/becas/${entry.id}.mdx`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
          >
            <Icon name="mdi:pencil" class="size-3" />
            Editar contenido
          </a>
        </div>
      </aside>

      <div class="md:order-1 md:col-span-2 md:pr-8 pt-8 pb-8 min-w-0">
        <section id="tabbed-content">
          <Content />
        </section>
      </div>
    </div>

    <span data-pagefind-meta="kind:beca"></span>
  </div>
</Layout>
