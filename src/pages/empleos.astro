---
import JobsBoard from "@/components/jobs/JobsBoard";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import { Icon } from "astro-icon/components";
import jobsDataset from "@/data/jobs.generated.json";
import {
  formatDateShort,
  parseDate,
  startOfDay,
  startOfToday,
} from "@/lib/dates";

const today = startOfToday();
const activeJobs = jobsDataset.jobs.filter((job) => {
  if (!job.closingDate) return true;
  const closing = parseDate(job.closingDate);
  if (!closing) return true;
  return startOfDay(closing) >= today;
});
---

<Layout
  title="Llamados laborales en Uruguay"
  description="Explora llamados abiertos de Uruguay Concursa con filtros y vista centralizada."
>
  <PagefindIndex
    title="Empleos en Uruguay"
    description="Llamados laborales y concursos abiertos de Uruguay Concursa, con filtros y vista centralizada."
    kind="pagina"
  />

  <Block class="border-b border-border">
    <PageHeader title="Llamados laborales de Uruguay">
      El siguiente listado es una recopilación semanal de los concursos
      actualmente disponibles y activos del sitio {" "}
      <a
        href="https://www.uruguayconcursa.gub.uy"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-dotted underline-offset-3 hover:text-foreground"
        >Uruguay Concursa</a
      >. El proyecto busca mejorar la experiencia de los usuarios.
    </PageHeader>

    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class="badge inline-flex items-center gap-1" data-variant="secondary">
        <Icon
          name="mdi:format-list-bulleted"
          width="14"
          height="14"
          class="shrink-0"
          aria-hidden="true"
        />
        {activeJobs.length} llamados activos
      </span>
      <span class="text-muted-foreground inline-flex items-center gap-1">
        <Icon
          name="mdi:clock-outline"
          width="14"
          height="14"
          class="shrink-0"
          aria-hidden="true"
        />
        Actualizado: {formatDateShort(jobsDataset.scrapedAt)}
      </span>
    </div>
  </Block>

  <Block>
    <JobsBoard
      client:load
      initialQuery={Astro.url.searchParams.get("q") ?? ""}
      initialOrganization={Astro.url.searchParams.get("org") ?? ""}
      initialTaskType={Astro.url.searchParams.get("type") ?? ""}
      initialAfro={Astro.url.searchParams.get("afro") === "1"}
      initialDiscapacidad={Astro.url.searchParams.get("disc") === "1"}
      initialTrans={Astro.url.searchParams.get("trans") === "1"}
      initialVictimas={Astro.url.searchParams.get("vict") === "1"}
      initialPage={Math.max(
        1,
        Number(Astro.url.searchParams.get("page") ?? "1"),
      )}
    />
  </Block>
</Layout>
