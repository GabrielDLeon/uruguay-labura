---
import JobsBoard from "@/components/jobs/JobsBoard";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import { Icon } from "astro-icon/components";
import jobsDataset from "@/data/jobs.generated.json";
import { formatDateShort } from "@/lib/dates";
---

<Layout
  title="Llamados laborales en Uruguay"
  description="Explora llamados y concursos abiertos de sitios oficiales de Uruguay con filtros y vista centralizada."
>
  <PagefindIndex
    title="Empleos en Uruguay"
    description="Llamados laborales y concursos abiertos de sitios oficiales de Uruguay, con filtros y vista centralizada."
    kind="pagina"
  />

  <Block class="border-b border-border">
    <PageHeader title="Llamados laborales de Uruguay">
      Explorá los llamados abiertos de sitios oficiales de Uruguay y encontrá tu
      próxima oportunidad.
    </PageHeader>

    <p class="text-muted-foreground inline-flex items-center gap-1 text-sm">
      <Icon
        name="keyline-icons:clock-fill"
        width="14"
        height="14"
        class="shrink-0"
        aria-hidden="true"
      />
      Actualizado:{" "}
      <time datetime={jobsDataset.scrapedAt}>
        {formatDateShort(jobsDataset.scrapedAt)}
      </time>
    </p>
  </Block>

  <JobsBoard
    client:load
    initialQuery={Astro.url.searchParams.get("q") ?? ""}
    initialOrganization={Astro.url.searchParams.get("org") ?? ""}
    initialTaskType={Astro.url.searchParams.get("type") ?? ""}
    initialAfro={Astro.url.searchParams.get("afro") === "1"}
    initialDiscapacidad={Astro.url.searchParams.get("disc") === "1"}
    initialTrans={Astro.url.searchParams.get("trans") === "1"}
    initialVictimas={Astro.url.searchParams.get("vict") === "1"}
    initialPage={Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1"))}
    initialJobId={Astro.url.searchParams.get("job") ?? ""}
  />
</Layout>
