---
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import { Icon } from "astro-icon/components";
import PageHeader from "@/components/PageHeader.astro";
import HomeStats from "@/components/HomeStats.astro";
import ClosingSoon from "@/components/ClosingSoon.astro";
import DashboardSection from "@/components/dashboard/DashboardSection.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import type { JobsDataset } from "@/types/jobs";
import jobsData from "@/data/jobs.generated.json";

const dataset = jobsData as unknown as JobsDataset;
const dashboard = dataset.dashboard;
---

<Layout
  title="Empleos y educación en Uruguay"
  description="Directorio centralizado de llamados laborales y oportunidades educativas en Uruguay."
>
  <PagefindIndex
    title="Uruguay Labura — Empleos y educación en Uruguay"
    description="Directorio centralizado de llamados laborales y oportunidades educativas en Uruguay."
    kind="pagina"
  />

  <Block>
    <PageHeader
      title="Uruguay Labura"
      description="Directorio centralizado de llamados laborales y oportunidades educativas en Uruguay. Seleccioná una sección para empezar."
    />

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <a
        href="/empleos"
        class="group flex flex-col gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--card-bg)] p-6 transition-colors hover:border-[var(--color-accent)]"
      >
        <span
          class="flex size-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--muted)] text-foreground transition-colors group-hover:bg-[var(--color-accent)]/10"
        >
          <Icon
            name="mdi:briefcase-outline"
            class="size-5"
            aria-hidden="true"
          />
        </span>
        <div>
          <h2 class="text-lg font-semibold text-foreground">Empleos</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Llamados laborales de Uruguay Concursa con filtros y vista
            centralizada.
          </p>
        </div>
      </a>

      <a
        href="/educacion"
        class="group flex flex-col gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--card-bg)] p-6 transition-colors hover:border-[var(--color-accent)]"
      >
        <span
          class="flex size-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--muted)] text-foreground transition-colors group-hover:bg-[var(--color-accent)]/10"
        >
          <Icon name="mdi:school-outline" class="size-5" aria-hidden="true" />
        </span>
        <div>
          <h2 class="text-lg font-semibold text-foreground">Educación</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Postgrados, maestrías, especializaciones y otras opciones de
            formación superior en Uruguay.
          </p>
        </div>
      </a>
    </div>

    <HomeStats />

    <ClosingSoon />

    {dashboard && <DashboardSection dashboard={dashboard} />}

    <section class="my-12">
      <a
        href="/acerca"
        class="group flex flex-col gap-3 rounded-lg border border-border bg-card p-6 transition-colors hover:border-accent sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="text-lg font-semibold text-foreground">
            Sobre el Proyecto
          </h2>
          <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
            La historia, la motivación y las metas de Uruguay Labura: por qué
            nace y hacia dónde apunta.
          </p>
        </div>
        <span
          class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-foreground hover:text-background"
          aria-hidden="true"
        >
          Conocer más
          <Icon
            name="mdi:arrow-right"
            class="size-4 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </span>
      </a>
    </section>
  </Block>
</Layout>
