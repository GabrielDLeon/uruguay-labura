---
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import EducationTable from "@/components/careers/EducationTable";
import { absUrl, breadcrumbList } from "@/lib/seo";
import { getBreadcrumbs } from "@/lib/breadcrumbs";

const breadcrumbs = getBreadcrumbs(Astro.url.pathname);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(breadcrumbs, `${absUrl("/educacion/carreras")}#breadcrumb`),
  ],
};
---

<Layout
  title="Carreras en Uruguay"
  description="Guía de carreras universitarias y terciarias disponibles en Uruguay: licenciaturas, ingenierías, maestrías, tecnicaturas y más."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <PagefindIndex
    title="Carreras en Uruguay"
    description="Carreras universitarias y programas de educación superior en Uruguay. Explorá las opciones de grado, posgrado y formación técnica por institución."
    kind="pagina"
  />

  <Block>
    <PageHeader
      title="Carreras"
      description="Programas de grado, posgrado y formación técnica ofrecidos por universidades e instituciones de educación superior en Uruguay."
    />

    <EducationTable client:visible />
  </Block>
</Layout>
