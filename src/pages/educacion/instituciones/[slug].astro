---
import { getCollection, render } from "astro:content";

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import { institutionTypeLabels } from "@/lib/institution";
import { showDrafts } from "@/lib/careers";
import UruguayMap from "@/components/UruguayMap.astro";
import AsideSection from "@/components/AsideSection.astro";
import { locationsToIds } from "@/lib/departments";
import InstitutionCard from "@/components/InstitutionCard.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import CampusesTable from "@/components/careers/CampusesTable";
import CareersTable from "@/components/careers/CareersTable";

export async function getStaticPaths() {
  const entries = await getCollection("institutions");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      otherInstitutions: entries.filter(
        (inst) => inst.id !== entry.id && inst.data.isActive,
      ),
    },
  }));
}

const { entry, otherInstitutions } = Astro.props;
const { Content } = await render(entry);

const programs = await getCollection(
  "careers",
  ({ data }) =>
    data.institution === entry.id &&
    (showDrafts || !data.draft) &&
    data.listable,
);
const hasCareers = programs.length > 0;
---

<Layout
  title={entry.data.short ?? entry.data.name}
  description={`${entry.data.name} — ${institutionTypeLabels[entry.data.type]} university in Uruguay.`}
>
  <Block class="border-b">
    <div class="mb-4">
      <a
        href="/educacion/instituciones"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Volver a Instituciones
      </a>
    </div>

    <div class="flex items-start gap-6">
      {
        entry.data.logo && (
          <Image
            src={entry.data.logo}
            alt={entry.data.name}
            class="h-32 w-auto object-contain shrink-0 mt-1 rounded-lg"
          />
        )
      }
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-3">
          <span
            class="badge"
            data-variant={entry.data.type === "public"
              ? "success"
              : "secondary"}
          >
            {institutionTypeLabels[entry.data.type]}
          </span>
          {
            entry.data.location ? (
              <span class="text-xs text-muted-foreground">
                {entry.data.location}
              </span>
            ) : null
          }
        </div>

        <h1 class="text-2xl mb-1 font-bold text-foreground sm:text-3xl">
          {
            entry.data.short
              ? `${entry.data.name} (${entry.data.short})`
              : entry.data.name
          }
        </h1>
        {
          entry.data.description ? (
            <p class="text-muted-foreground text-xs leading-relaxed max-w-xl">
              {entry.data.description}
            </p>
          ) : null
        }
      </div>
    </div>
  </Block>

  <PagefindIndex
    title={entry.data.name}
    description={entry.data.description}
    kind="institucion"
    meta={{
      description: entry.data.description ?? undefined,
    }}
  />

  <div data-pagefind-ignore="all">
    <div class="grid md:grid-cols-3">
      <aside class="h-full md:order-2 md:border-l mb-8 md:mb-0">
        <Block class="flex h-full flex-col gap-8">
          <AsideSection title="Contacto">
            <div class="flex flex-col gap-2">
              <a
                href={entry.data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
                data-size="sm"
              >
                Sitio oficial
              </a>
              {
                entry.data.contactEmail ? (
                  <a
                    href={`mailto:${entry.data.contactEmail}`}
                    class="btn"
                    data-variant="outline"
                    data-size="sm"
                  >
                    {entry.data.contactEmail}
                  </a>
                ) : null
              }
              {
                entry.data.phone ? (
                  <a
                    href={`tel:${entry.data.phone}`}
                    class="btn"
                    data-variant="outline"
                    data-size="sm"
                  >
                    {entry.data.phone}
                  </a>
                ) : null
              }
            </div>
          </AsideSection>

          <AsideSection
            title="Presencia"
            style={entry.data.color
              ? `--map-highlight: ${entry.data.color}`
              : undefined}
          >
            <UruguayMap highlighted={locationsToIds(entry.data.departments)} />
          </AsideSection>

          {
            entry.data.tags.length > 0 ? (
              <AsideSection title="Tags">
                <div class="flex flex-wrap gap-1">
                  {entry.data.tags.map((tag) => (
                    <span class="badge text-xs" data-variant="outline">
                      {tag}
                    </span>
                  ))}
                </div>
              </AsideSection>
            ) : null
          }

          <div class="flex justify-center">
            <a
              href={`https://github.com/GabrielDLeon/uruguay-laburos/edit/main/src/content/institutions/${entry.id}.mdx`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              <Icon name="mdi:pencil" class="size-3" />
              Editar contenido
            </a>
          </div>
        </Block>
      </aside>

      <div class="md:order-1 md:col-span-2 min-w-0">
        <Block>
          <div class="prose prose-sm dark:prose-invert max-w-none">
            <Content />
          </div>
        </Block>

        {
          hasCareers && (
            <Block class="border-t border-border">
              <h2 class="text-lg font-bold text-foreground mb-4">Carreras</h2>
              <CareersTable institution={entry.id} client:visible />
            </Block>
          )
        }

        {
          entry.data.campuses.length > 0 && (
            <Block class="border-t border-border">
              <h2 class="text-lg font-bold text-foreground mb-4">Sedes</h2>
              <CampusesTable campuses={entry.data.campuses} client:visible />
            </Block>
          )
        }
      </div>
    </div>

    {
      otherInstitutions.length > 0 ? (
        <Block class="border-t">
          <h2 class="text-lg font-bold text-foreground mb-4">
            Otras instituciones
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {otherInstitutions.map((inst) => (
              <InstitutionCard
                href={`/educacion/instituciones/${inst.id}`}
                name={inst.data.name}
                short={inst.data.short}
                description={inst.data.description}
                type={inst.data.type}
                logo={inst.data.logo}
              />
            ))}
          </div>
        </Block>
      ) : null
    }
  </div>
</Layout>
