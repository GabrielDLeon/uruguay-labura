---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import PageHeader from "@/components/PageHeader.astro";
import InstitutionCard from "@/components/InstitutionCard.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { absUrl, breadcrumbList } from "@/lib/seo";

const entries = await getCollection("institutions");

entries.sort((a, b) => a.data.name.localeCompare(b.data.name, "es"));

const breadcrumbs = [
  { label: "Inicio", url: absUrl("/") },
  { label: "Educación", url: absUrl("/educacion") },
  { label: "Instituciones", url: absUrl("/educacion/instituciones") },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbList(
      breadcrumbs,
      `${absUrl("/educacion/instituciones")}#breadcrumb`,
    ),
  ],
};
---

<Layout
  title="Instituciones"
  description="Directorio de universidades e instituciones de educación superior en Uruguay."
  jsonLd={jsonLd}
>
  <PagefindIndex
    title="Instituciones en Uruguay"
    description="Universidades e instituciones de educación superior en Uruguay. Explora las instituciones para conocer sus programas, ubicaciones e información de contacto."
    kind="pagina"
  />

  <Block>
    <Breadcrumbs items={breadcrumbs} />

    <PageHeader
      title="Instituciones"
      description="Universidades e instituciones de educación superior en Uruguay. Explora las instituciones para conocer sus programas, ubicaciones e información de contacto."
    />

    <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry) => (
          <InstitutionCard
            href={`/educacion/instituciones/${entry.id}`}
            name={entry.data.name}
            short={entry.data.short}
            description={entry.data.description}
            type={entry.data.type}
            logo={entry.data.logo}
          />
        ))
      }
    </section>

    {
      entries.length === 0 ? (
        <p class="text-muted-foreground mt-4 text-sm">
          No hay instituciones registradas por el momento.
        </p>
      ) : null
    }
  </Block>
</Layout>
