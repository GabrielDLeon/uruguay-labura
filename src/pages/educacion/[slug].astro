---
import { getCollection, render } from "astro:content";

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import {
  degreeTypeLabels,
  modalityLabels,
  modalityBarFilled,
  shiftLabels,
  getDegreeTypeBarInfo,
  formatDate,
  getSolidarityFundInfo,
  showDrafts,
} from "@/lib/educacion";
import SimilarCareer from "@/components/SimilarCareer.astro";
import SolidarityFundInfo from "@/components/SolidarityFundInfo.astro";
import BarIndicator from "@/components/BarIndicator.astro";
import AsideSection from "@/components/AsideSection.astro";
import KeyValueList from "@/components/KeyValueList.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";

export async function getStaticPaths() {
  const entries = await getCollection(
    "educacion",
    ({ data }) => showDrafts || !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const institutions = await getCollection("institutions");
const institutionEntry = entry.data.institution
  ? institutions.find((inst) => inst.id === entry.data.institution)
  : undefined;

const allEntries = await getCollection(
  "educacion",
  ({ data }) => import.meta.env.DEV || !data.draft,
);
const similarEntries = entry.data.similar
  .map((slug) => allEntries.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => e != null);

const becas = await getCollection("becas", ({ data }) => !data.draft);
const careerBecas = entry.data.becas
  .map((slug) => becas.find((b) => b.id === slug))
  .filter((b): b is NonNullable<typeof b> => b != null);

const solidarityFund = getSolidarityFundInfo(
  entry.data.institution,
  entry.data.duration,
);

const detailItems = [
  { label: "Área", value: entry.data.area },
  { label: "Duración", value: entry.data.duration },
  {
    label: "Dedicación semanal",
    value: entry.data.weeklyHours,
  },
  { label: "Créditos", value: entry.data.credits },
  { label: "Costo", value: entry.data.cost },
  { label: "Idioma", value: entry.data.language },
  { label: "Ubicación", value: entry.data.location },
  { label: "Acreditación", value: entry.data.accreditation },

  {
    label: "Inicio",
    value: entry.data.startDate ? formatDate(entry.data.startDate) : undefined,
  },
  {
    label: "Cierre inscripción",
    value: entry.data.applicationDeadline
      ? formatDate(entry.data.applicationDeadline)
      : undefined,
  },
];
---

<Layout
  title={entry.data.title}
  description={entry.data.description ??
    `${entry.data.degreeType} en ${entry.data.area} ofrecido por ${entry.data.institutionName}.`}
>
  <Block class="border-b">
    <div class="mb-4">
      <a
        href="/educacion"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Volver a Educación
      </a>
    </div>

    <div class="flex items-center gap-4">
      {
        institutionEntry?.data.logo && (
          <Image
            src={institutionEntry.data.logo}
            alt={institutionEntry.data.name}
            class="h-16 w-auto object-contain shrink-0 mt-1 rounded-lg sm:h-20"
          />
        )
      }
      <div>
        <h1 class="text-2xl mb-1 font-bold text-foreground sm:text-3xl">
          {entry.data.title}
        </h1>
        <p class="text-muted-foreground text-base">
          {
            entry.data.institution ? (
              <a
                href={`/educacion/instituciones/${entry.data.institution}`}
                class="hover:underline"
              >
                {entry.data.institutionName}
              </a>
            ) : (
              entry.data.institutionName
            )
          }
        </p>
      </div>
    </div>
  </Block>

  <PagefindIndex
    title={entry.data.title}
    description={entry.data.description}
    kind="carrera"
    meta={{
      degreeType:
        degreeTypeLabels[entry.data.degreeType] ?? entry.data.degreeType,
      modality: modalityLabels[entry.data.modality] ?? entry.data.modality,
      description: entry.data.description ?? undefined,
    }}
  />

  <div data-pagefind-ignore="all">
    <div class="grid md:grid-cols-3">
      <aside class="h-full md:order-2 md:border-l mb-8 md:mb-0">
        <Block class="flex h-full flex-col gap-8">
          {
            entry.data.description ? (
              <AsideSection title="Descripción">
                <p class="text-sm text-foreground leading-relaxed">
                  {entry.data.description}
                </p>
              </AsideSection>
            ) : null
          }
          <section class="space-y-3">
            <BarIndicator
              label="Tipo"
              value={degreeTypeLabels[entry.data.degreeType] ??
                entry.data.degreeType}
              total={4}
              filled={getDegreeTypeBarInfo(entry.data.degreeType).filled}
            />
            <BarIndicator
              label="Modalidad"
              value={modalityLabels[entry.data.modality] ?? entry.data.modality}
              total={3}
              filled={modalityBarFilled[entry.data.modality] ?? 1}
            />
            <BarIndicator
              label="Turno"
              value={shiftLabels[entry.data.shift] ?? entry.data.shift}
              total={3}
              filled={{ day: 1, night: 2, both: 3 }[entry.data.shift] ?? 1}
            />
          </section>
          <AsideSection title="Detalles">
            <KeyValueList items={detailItems} />
          </AsideSection>

          {
            solidarityFund.applies ? (
              <SolidarityFundInfo
                tier={solidarityFund.tier}
                additional={solidarityFund.additional}
              />
            ) : null
          }

          {
            careerBecas.length > 0 ? (
              <AsideSection title="Becas">
                <div class="flex flex-col gap-2">
                  {careerBecas.map((beca) => (
                    <a
                      href={`/educacion/becas/${beca.id}`}
                      class="rounded-lg border border-border bg-muted/30 p-4 block hover:bg-accent/50 transition-colors"
                    >
                      <span class="flex items-center gap-2 text-sm text-foreground font-medium">
                        <Icon
                          name="mdi:hand-coin-outline"
                          class="size-4 shrink-0"
                        />
                        <span>{beca.data.title}</span>
                      </span>
                      <span class="text-xs text-muted-foreground mt-1 block">
                        {beca.data.institution}
                      </span>
                    </a>
                  ))}
                </div>
              </AsideSection>
            ) : null
          }

          <AsideSection title="Contacto">
            <div class="flex flex-col gap-2">
              <a
                href={entry.data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
                data-size="sm"
              >
                Sitio web oficial
              </a>
              {
                entry.data.contactEmail ? (
                  Array.isArray(entry.data.contactEmail) ? (
                    entry.data.contactEmail.map((email) => (
                      <button
                        type="button"
                        class="btn"
                        data-variant="outline"
                        data-copy={email}
                      >
                        {email}
                      </button>
                    ))
                  ) : (
                    <button
                      type="button"
                      class="btn"
                      data-variant="outline"
                      data-copy={entry.data.contactEmail}
                    >
                      {entry.data.contactEmail}
                    </button>
                  )
                ) : null
              }
            </div>
          </AsideSection>

          <div class="flex justify-center">
            <a
              href={`https://github.com/GabrielDLeon/uruguay-laburos/edit/main/src/content/educacion/${entry.id}.mdx`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              <Icon name="mdi:pencil" class="size-3" />
              Editar contenido
            </a>
          </div>
        </Block>
      </aside>

      <div class="md:order-1 md:col-span-2 min-w-0">
        <Block>
          <section id="tabbed-content">
            <Content />
          </section>
        </Block>
      </div>
    </div>

    {
      similarEntries.length > 0 ? (
        <Block class="border-t">
          <h2 class="text-lg font-bold text-foreground mb-4">
            Te podría interesar
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {similarEntries.map((similar) => {
              const inst = institutions.find(
                (i) => i.id === similar.data.institution,
              );
              return (
                <SimilarCareer
                  title={similar.data.short ?? similar.data.title}
                  institutionName={
                    inst?.data.short ??
                    inst?.data.name ??
                    similar.data.institutionName
                  }
                  institutionLogo={inst?.data.logo}
                  description={similar.data.description}
                  degreeTypeLabel={
                    degreeTypeLabels[similar.data.degreeType] ??
                    similar.data.degreeType
                  }
                  modalityLabel={
                    modalityLabels[similar.data.modality] ??
                    similar.data.modality
                  }
                  url={`/educacion/${similar.id}`}
                />
              );
            })}
          </div>
        </Block>
      ) : null
    }
  </div>
</Layout>
