---
import { getCollection, render } from "astro:content";

import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Block from "@/components/Block.astro";
import AsideSection from "@/components/AsideSection.astro";
import KeyValueList from "@/components/KeyValueList.astro";
import PagefindIndex from "@/components/PagefindIndex.astro";

export async function getStaticPaths() {
  const entries = await getCollection(
    "scholarships",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeLabelMap: Record<string, string> = {
  estatal: "Estatal",
  privada: "Privada",
  internacional: "Internacional",
  gremial: "Gremial",
};

const detailItems = [
  {
    label: "Tipo",
    value: entry.data.type,
  },
  {
    label: "Institución",
    value: entry.data.institution,
  },
];
---

<Layout
  title={entry.data.title}
  description={entry.data.description ??
    `Información sobre ${entry.data.title} en Uruguay.`}
>
  <Block class="border-b">
    <div class="mb-4">
      <a
        href="/educacion/becas"
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        ← Volver a Becas
      </a>
    </div>

    <div>
      <h1 class="text-2xl mb-1 font-bold text-foreground sm:text-3xl">
        {entry.data.title}
      </h1>
      <p class="text-muted-foreground text-base">
        {entry.data.institution}
      </p>
    </div>
  </Block>

  <PagefindIndex
    title={entry.data.title}
    description={entry.data.description}
    kind="beca"
    meta={{
      institution: entry.data.institution,
      type: entry.data.type,
    }}
  />

  <div data-pagefind-body>
    <div class="grid md:grid-cols-3">
      <aside class="h-full md:order-2 md:border-l mb-8 md:mb-0">
        <Block class="flex h-full flex-col gap-8">
          {
            entry.data.description ? (
              <AsideSection title="Descripción">
                <p class="text-sm text-foreground leading-relaxed">
                  {entry.data.description}
                </p>
              </AsideSection>
            ) : null
          }

          <AsideSection title="Detalles">
            <KeyValueList items={detailItems} />
          </AsideSection>

          {
            entry.data.tags.length > 0 ? (
              <AsideSection title="Categorías">
                <div class="flex flex-wrap gap-2">
                  {entry.data.tags.map((tag) => (
                    <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                      {typeLabelMap[tag] ?? tag}
                    </span>
                  ))}
                </div>
              </AsideSection>
            ) : null
          }

          <AsideSection title="Enlaces">
            <div class="flex flex-col gap-2">
              <a
                href={entry.data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
                data-size="sm"
              >
                Sitio web oficial
              </a>
            </div>
          </AsideSection>

          <div class="flex justify-center">
            <a
              href={`https://github.com/GabrielDLeon/uruguay-laburos/edit/main/src/content/scholarships/${entry.id}.mdx`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
            >
              <Icon name="mdi:pencil" class="size-3" />
              Editar contenido
            </a>
          </div>
        </Block>
      </aside>

      <div class="md:order-1 md:col-span-2 min-w-0">
        <Block>
          <section id="tabbed-content">
            <Content />
          </section>
        </Block>
      </div>
    </div>

    <span data-pagefind-meta="kind:beca"></span>
  </div>
</Layout>
